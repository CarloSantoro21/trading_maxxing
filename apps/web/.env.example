# Copia este archivo a .env.local (opcional: sin él todo funciona con los defaults).
# Son públicas por diseño (van en el bundle del navegador); el control de acceso lo dan
# Cloudflare Access y la API.

# Badge del encabezado: ambiente (local | dev | prod) y commit del build.
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_COMMIT_SHA=

# Origen de la API. Vacío = mismo origen (/api/*): en `pnpm dev` lo reenvía next.config.ts a
# API_DEV_URL y en Cloudflare Pages la Pages Function functions/api/[[path]].ts.
NEXT_PUBLIC_API_BASE=

# Solo `pnpm dev`: a dónde reenvía /api/* (wrangler dev de apps/api).
API_DEV_URL=http://localhost:8787
