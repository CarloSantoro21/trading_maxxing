# Copia este archivo a .env y llena los valores. .env nunca se sube al repo.

# --- Supabase local (valores de `supabase status`) ---
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo si los tokens vienen en HS256; la CLI 2.117 firma con ES256 y la api usa el JWKS.
SUPABASE_JWT_SECRET=
# Orígenes del frontend que pueden llamar a la api (CORS), separados por comas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Binance Spot Testnet (https://testnet.binance.vision) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Motor (services/engine) ---
ENGINE_SYMBOLS=BTCUSDT
ENGINE_TIMEFRAME=1m
# Bot de respaldo para decisiones sin bot_id (opcional). Con el orquestador (#19) cada
# decisión trae su bot y los fills se guardan para ese bot si hay SUPABASE_SERVICE_ROLE_KEY.
ENGINE_BOT_ID=

# --- Worker agents (services/agents): orquestador (#19) y ledger de referencia (#57) ---
# Las tres piezas leen o escriben el mismo stream tm:signals (formato: tm_agents.signals).
# Todas necesitan REDIS_URL; sin ella el worker solo escribe su heartbeat. Cada una se apaga
# con 0 (false/no/off) para correrla en otro contenedor; por omisión corren las tres.
# Capa compartida: señales, vetos y SimulationGate una vez para todos -> tm:signals
# ORCHESTRATOR_SHARED=1
# Capa por usuario: un BotRunner por bot en running; tm:signals -> tm:decisions / tm:shadow
# ORCHESTRATOR_BOTS=1
# ReferenceService: portafolio de referencia por estrategia y LifecycleMonitor. Además de
# REDIS_URL necesita SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
# REFERENCE_SERVICE=1
# Símbolos que evalúa la capa compartida
ORCHESTRATOR_SYMBOLS=BTCUSDT,ETHUSDT
# Segundos entre ciclos del orquestador y entre heartbeats (y ciclos del ReferenceService)
# ORCHESTRATOR_TICK_SECONDS=1
# HEARTBEAT_INTERVAL=10

# --- LLM y noticias (opcionales; por defecto no cuesta nada) ---
# Con los valores por defecto el motor corre SIN ninguna llave de LLM ni de noticias:
# sin filtro de noticias (el orquestador recibe news=None) y explicaciones con plantilla.
# Ver la tabla completa en services/agents/README.md.
NEWS_ENABLED=false
EXPLAINER_ENABLED=false
# LLM_PROVIDER: none (por defecto) | workers-ai | groq | openai-compatible | fake (pruebas)
# Con NEWS_ENABLED=true y LLM_PROVIDER=none las noticias se clasifican por palabras clave.
LLM_PROVIDER=none
# workers-ai (Cloudflare, 10,000 neurons/día gratis): token con permiso "Workers AI"
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
# WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# groq (tier gratuito)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# openai-compatible (OpenRouter, Together, Ollama local, etc.)
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama3.1
# OPENAI_COMPAT_RESPONSE_FORMAT=json_schema   # o json_object si el servidor no soporta esquemas
# Comunes: LLM_TIMEOUT_SECONDS=20, LLM_MAX_RETRIES=3
# NEWS_SOURCE: rss (por defecto, gratis) | cryptopanic
NEWS_SOURCE=rss
# NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed
# NEWS_RSS_MAX_AGE_HOURS=24
# NEWS_REFRESH_SECONDS=300
CRYPTOPANIC_TOKEN=
# Opcionales: CRYPTOPANIC_PLAN=developer, NEWS_VETO_HIGH_HOURS=4, NEWS_VETO_CRITICAL_HOURS=24
# Interruptor en caliente: env (por defecto, lee NEWS_ENABLED/EXPLAINER_ENABLED) | worker-api
# (GET {WORKER_API_URL}/internal/settings con el token de servicio, tabla settings de D1)
# SETTINGS_SOURCE=env
# WORKER_API_URL=
# WORKER_SERVICE_TOKEN=
# SETTINGS_REFRESH_SECONDS=300
# Vetos del NewsAgent: docker-compose ya define REDIS_URL; sin ella se guardan en memoria
# REDIS_URL=redis://localhost:6379/0

# --- Pronóstico ---
# En contenedor: http://forecast:8001 · Nativo con MPS (make up-mps): http://host.docker.internal:8001
FORECAST_URL=http://forecast:8001
FORECAST_DEVICE=auto

LOG_LEVEL=INFO
