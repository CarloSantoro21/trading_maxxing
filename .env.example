# Copia este archivo a .env y llena los valores. .env nunca se sube al repo.

# --- Supabase local (valores de `supabase status`) ---
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo si los tokens vienen en HS256; la CLI 2.117 firma con ES256 y la api usa el JWKS.
SUPABASE_JWT_SECRET=
# Orígenes del frontend que pueden llamar a la api (CORS), separados por comas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Binance Spot Testnet (https://testnet.binance.vision) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Motor (services/engine) ---
ENGINE_SYMBOLS=BTCUSDT
ENGINE_TIMEFRAME=1m
# Bot de respaldo para decisiones sin bot_id (opcional). Con el orquestador (#19) cada
# decisión trae su bot y los fills se guardan para ese bot si hay SUPABASE_SERVICE_ROLE_KEY.
ENGINE_BOT_ID=

# --- Worker agents (services/agents): orquestador (#19) y ledger de referencia (#57) ---
# Las tres piezas leen o escriben el mismo stream tm:signals (formato: tm_agents.signals).
# Todas necesitan REDIS_URL; sin ella el worker solo escribe su heartbeat. Cada una se apaga
# con 0 (false/no/off) para correrla en otro contenedor; por omisión corren las tres.
# Capa compartida: señales, vetos y SimulationGate una vez para todos -> tm:signals
# ORCHESTRATOR_SHARED=1
# Capa por usuario: un BotRunner por bot en running; tm:signals -> tm:decisions / tm:shadow
# ORCHESTRATOR_BOTS=1
# ReferenceService: portafolio de referencia por estrategia y LifecycleMonitor. Además de
# REDIS_URL necesita SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
# REFERENCE_SERVICE=1
# Símbolos que evalúa la capa compartida
ORCHESTRATOR_SYMBOLS=BTCUSDT,ETHUSDT
# Segundos entre ciclos del orquestador y entre heartbeats (y ciclos del ReferenceService)
# ORCHESTRATOR_TICK_SECONDS=1
# HEARTBEAT_INTERVAL=10

# --- LLM y noticias ---
# LLM_PROVIDER: groq (por defecto) o fake (sin llaves, no clasifica)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Opcionales: GROQ_MODEL=openai/gpt-oss-20b, LLM_TIMEOUT_SECONDS=20, LLM_MAX_RETRIES=3
CRYPTOPANIC_TOKEN=
# Opcionales: CRYPTOPANIC_PLAN=developer, NEWS_VETO_HIGH_HOURS=4, NEWS_VETO_CRITICAL_HOURS=24
# Vetos del NewsAgent: docker-compose ya define REDIS_URL; sin ella se guardan en memoria
# REDIS_URL=redis://localhost:6379/0

# --- Pronóstico ---
# En contenedor: http://forecast:8001 · Nativo con MPS (make up-mps): http://host.docker.internal:8001
FORECAST_URL=http://forecast:8001
FORECAST_DEVICE=auto

LOG_LEVEL=INFO
