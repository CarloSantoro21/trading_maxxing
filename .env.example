# Copia este archivo a .env y llena los valores. .env nunca se sube al repo.

# --- Supabase local (valores de `supabase status`) ---
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Binance Spot Testnet (https://testnet.binance.vision) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Motor (services/engine) ---
ENGINE_SYMBOLS=BTCUSDT
ENGINE_TIMEFRAME=1m
# Bot de Supabase al que se atribuyen las operaciones (opcional; sin él no se guardan fills)
ENGINE_BOT_ID=

# --- LLM y noticias ---
LLM_PROVIDER=groq
GROQ_API_KEY=
CRYPTOPANIC_TOKEN=

# --- Pronóstico ---
# En contenedor: http://forecast:8001 · Nativo con MPS (make up-mps): http://host.docker.internal:8001
FORECAST_URL=http://forecast:8001
FORECAST_DEVICE=auto

LOG_LEVEL=INFO
