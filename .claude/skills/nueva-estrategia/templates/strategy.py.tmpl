# TODO: ajusta los defaults a tu estrategia.
DEFAULT_LOOKBACK = 50
DEFAULT_PERIOD = pd.Timedelta(days=1)


@register_strategy("<nombre_corto>")  # TODO: nombre en snake_case; es la clave del registro.
class <NombreAgent>(BaseAgent):  # TODO: nombra la clase.
    timeframe = Timeframe.D1  # TODO: elige la temporalidad que casa con el paper.

    def __init__(
        self,
        lookback: int = DEFAULT_LOOKBACK,
        # TODO: agrega aquí los parámetros del paper (umbrales, ventanas, modos...).
        **params: object,
    ) -> None:
        super().__init__(lookback=lookback, **params)
        if lookback < 2:
            raise ValueError("lookback debe ser >= 2 velas")
        self.lookback = int(lookback)

    def analyze(self, ctx: AgentContext) -> Signal:
        now = pd.Timestamp(ctx.now).tz_convert("UTC")
        bars = closed_bars(ctx.bars_for(self.timeframe), now, DEFAULT_PERIOD)

        if len(bars) < self.lookback + 1:
            # Historia insuficiente: la señal es flat con confianza 0.
            return Signal(
                symbol=ctx.symbol,
                direction=Direction.FLAT,
                confidence=0.0,
                horizon=Horizon.MEDIUM,
                timeframe=self.timeframe,
                source=self.name,
                generated_at=now.to_pydatetime(),
                metadata={
                    "bars_used": len(bars),
                    "reason": "historia insuficiente",
                    "last_close": float(bars["close"].iloc[-1]) if len(bars) else None,
                },
            )

        close = bars["close"].to_numpy(dtype=float)

        # TODO: calcula la señal (regla del paper). `signal_value` debe ser determinista.
        signal_value = _rule(close, self.lookback)
        direction = Direction.LONG if signal_value > 0 else Direction.FLAT
        confidence = float(min(1.0, abs(signal_value)))

        return Signal(
            symbol=ctx.symbol,
            direction=direction,
            confidence=confidence,
            horizon=Horizon.MEDIUM,
            timeframe=self.timeframe,
            source=self.name,
            generated_at=now.to_pydatetime(),
            metadata={
                "bars_used": len(bars),
                "last_close": float(close[-1]),
                # TODO: agrega aquí las llaves que el laboratorio y el orquestador necesitan.
            },
        )


