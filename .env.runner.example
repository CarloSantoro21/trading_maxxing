# Variables del motor en la Mac (docker-compose.runner.yml). Copia este archivo a .env.runner
# y llena los valores; .env.runner nunca se sube al repo (está en .gitignore).
#
#   cp .env.runner.example .env.runner && make runner-up
#
# Guía: docs/arquitectura/motor-en-la-mac.md

# --- Imágenes -----------------------------------------------------------------------------
# Cuenta u organización de Docker Hub de donde salen las imágenes trading-maxxing-<svc>.
DOCKERHUB_NAMESPACE=
# Tag de las imágenes (y ambiente): prod (rama main) o dev (rama develop).
TM_ENV=prod

# --- API en Cloudflare Workers (todo lo persistente vive en D1) ---------------------------
# Base del Worker SIN /internal. prod: https://tm-api.<subdominio>.workers.dev
#                                    dev:  https://tm-api-dev.<subdominio>.workers.dev
TM_API_URL=
# Secreto SERVICE_TOKEN del Worker (wrangler secret put SERVICE_TOKEN --env <env>).
# Va en el header X-Service-Token de cada llamada a /internal/*.
TM_SERVICE_TOKEN=
# Service token de Cloudflare Access que protege /internal/* (outputs de Terraform en
# trading_maxxing-infra: motor_service_token_client_id / motor_service_token_client_secret).
# Opcionales: si /internal/* no está detrás de Access, déjalos vacíos.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Opcionales del cliente HTTP: segundos por petición y reintentos con backoff (0.5, 1, 2... s)
# TM_API_TIMEOUT_SECONDS=10
# TM_API_RETRIES=3
# Segundos entre latidos (POST /internal/heartbeat, lo muestra /api/engine/status)
# TM_HEARTBEAT_SECONDS=30

# --- Binance Spot Testnet (https://testnet.binance.vision) --------------------------------
# Sin llaves el motor arranca en modo "offline" (no manda órdenes).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- engine -------------------------------------------------------------------------------
ENGINE_SYMBOLS=BTCUSDT,ETHUSDT
ENGINE_TIMEFRAME=1m
# Bot de respaldo para decisiones sin bot_id (opcional; cada decisión ya trae su bot).
ENGINE_BOT_ID=
# Backtests encolados desde el frontend (GET /internal/backtests?status=queued)
# BACKTEST_JOBS=1
# BACKTEST_POLL_SECONDS=60

# --- agents (orquestador y ledger de referencia) ------------------------------------------
ORCHESTRATOR_SYMBOLS=BTCUSDT,ETHUSDT
# ORCHESTRATOR_SHARED=1
# ORCHESTRATOR_BOTS=1
# REFERENCE_SERVICE=1
# Comandos start/stop/kill de los bots: GET /internal/commands cada N segundos
# COMMANDS_POLL_SECONDS=5
# Copia de cada decisión a POST /internal/decisions (auditoría, GET /api/decisions)
# DECISIONS_AUDIT=1
# Equity de cada bot a POST /internal/equity-snapshots cada N segundos
# EQUITY_SNAPSHOT_SECONDS=300

# --- LLM y noticias (opcionales; apagados no cuestan nada) --------------------------------
# Los interruptores news_enabled / explainer_enabled se leen de GET /internal/settings (el
# admin los cambia en el frontend). NEWS_ENABLED/EXPLAINER_ENABLED solo se usan si la API
# nunca respondió. SETTINGS_SOURCE=env para ignorar la API.
NEWS_ENABLED=false
EXPLAINER_ENABLED=false
# SETTINGS_REFRESH_SECONDS=300
# none | workers-ai | groq | openai-compatible
LLM_PROVIDER=none
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
GROQ_API_KEY=
NEWS_SOURCE=rss

LOG_LEVEL=INFO
